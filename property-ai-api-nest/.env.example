# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Postgres
DATABASE_URL=postgres://property_ai:property_ai@localhost:5432/property_ai

# Redis (rate limiting, caching, refresh-token store)
# Host-published port is 6380, not the default 6379 - see docker-compose.yml
REDIS_URL=redis://localhost:6380

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# AI provider (Google Gemini) - get a free key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
